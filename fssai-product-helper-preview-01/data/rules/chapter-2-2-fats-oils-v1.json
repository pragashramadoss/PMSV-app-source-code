  "common_rules": [
    {
      "type": "fatty_acid_composition",
      "clause": "2.2.7",
      "text": "Oils and fats covered by Chapter 2.2 must comply with the applicable fatty-acid-composition table where listed."
    },
    {
      "type": "peroxide_value",
      "clause": "2.2.8",
      "text": "Apply the product-specific peroxide-value limits in clause 2.2.8 to oils and fats where applicable."
    },
    {
      "type": "trans_fat",
      "value_max_pct": 2,
      "effective_from": "2022-01-01",
      "text": "Where Chapter 2.2 prescribes a trans-fat limit for the product, the current maximum is 2% by weight."
    },
    {
      "type": "additives",
      "text": "Food additives are permitted only as provided by the applicable Chapter 2.2 clause and Appendix A."
    }
  ],
  "standards": [
    {
      "key": "2.2.1(16)",
      "name": "Refined Vegetable Oil",
      "status": "structured_core",
      "definition": "Vegetable oil obtained by expression or solvent extraction and refined by the processes permitted in clause 2.2.1(16).",
      "composition": [
        {
          "parameter": "Acid value",
          "operator": "<=",
          "value": 0.6,
          "unit": "mg KOH/g oil"
        },
        {
          "parameter": "Moisture",
          "operator": "<=",
          "value": 0.1,
          "unit": "% by weight"
        },
        {
          "parameter": "Trans fatty acids",
          "operator": "<=",
          "value": 2,
          "unit": "% by weight",
          "effective_from": "2022-01-01"
        },
        {
          "parameter": "Argemone oil",
          "operator": "negative",
          "value": "Negative",
          "unit": "test"
        }
      ],
      "process_rules": [
        "Must be obtained from vegetable oils standardized in the regulations.",
        "Permitted refining steps include deacidification/physical or miscella refining, permitted degumming, bleaching and steam deodorisation as specified in the clause.",
        "No chemical agent other than those permitted by the clause may be used."
      ],
      "quality_rules": [
        "Clear and free from rancidity, adulterants, sediments, suspended/foreign matter, separated water, added colouring/flavouring substances and mineral oil."
      ],
      "label_rules": [
        "Clearly specify the name of the vegetable oil from which the refined oil was manufactured."
      ],
      "inheritance": [
        "The standards for the specified source edible oil also apply, except the refined-oil acid-value limit in 2.2.1(16) governs."
      ]
    },
    {
      "key": "2.2.1(7)",
      "name": "Rapeseed or Mustard Oil — Low Erucic Acid",
      "status": "cross_reference_structured",
      "applies_with": [
        "2.2.1(16) when sold as refined oil"
      ],
      "tests": [
        "Argemone oil negative"
      ],
      "note": "Source-oil identity standard retained; refined variants inherit the refined vegetable oil requirements."
