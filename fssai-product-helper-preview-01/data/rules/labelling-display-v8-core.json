  "product_specific_rules": [
    {
      "id": "caffeinated_beverage",
      "exact_names": [
        "Caffeinated Beverage"
      ],
      "source": "Food Safety and Standards (Food Products Standards and Food Additives) Regulations, 2011",
      "clause": "2.10.6(2)",
      "status": "active",
      "declarations": [
        {
          "id": "high_caffeine",
          "type": "calculated",
          "text_template": "High Caffeine: X mg/serving size",
          "requires": [
            "caffeine",
            "serving_size"
          ]
        },
        {
          "id": "caffeine_caution",
          "type": "fixed",
          "text": "Not recommended for children, pregnant or lactating women, persons sensitive to caffeine."
        },
        {
          "id": "daily_consumption",
          "type": "fixed",
          "text": "Consume not more than 500 ml per day"
        }
      ]
    }
  ],
  "schedule_ii": {
    "source_clause": "Schedule II · Mandatory Declarations",
    "ingredient_threshold_rules": [
      {
        "id": "polyols_10_percent",
        "aliases": [
          "sorbitol",
          "sorbitol syrup",
          "mannitol",
          "xylitol",
          "maltitol",
          "maltitol syrup",
          "lactitol",
          "isomalt",
          "erythritol",
          "polyol"
        ],
        "aggregation": "sum_matching_ingredients_w_w",
        "min_percent_w_w": 10,
        "declaration_short": "Polyols may have laxative effect",
        "status": "active"
      },
      {
        "id": "polydextrose_10_percent",
        "aliases": [
          "polydextrose"
        ],
        "aggregation": "sum_matching_ingredients_w_w",
