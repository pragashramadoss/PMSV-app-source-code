        "declaration_short": "Polydextrose may have laxative effect",
        "status": "active"
      },
      {
        "id": "added_caffeine",
        "aliases": [
          "caffeine"
        ],
        "aggregation": "presence",
        "min_percent_w_w": 0,
        "declaration_short": "CONTAINS CAFFEINE",
        "status": "active"
      },
      {
        "id": "isomaltulose",
        "aliases": [
          "isomaltulose"
        ],
        "aggregation": "presence",
        "min_percent_w_w": 0,
        "declaration_short": "Contains Isomaltulose — energy per 100 g or 100 ml must be declared",
        "status": "active"
      },
      {
        "id": "sorbitol_10_percent",
        "aliases": [
          "sorbitol",
          "sorbitol syrup"
        ],
        "aggregation": "sum_matching_ingredients_w_w",
        "min_percent_w_w": 10,
        "declaration_short": "Special sorbitol laxative/bloating/diarrhea and calcium-absorption warning required",
        "status": "active"
      }
