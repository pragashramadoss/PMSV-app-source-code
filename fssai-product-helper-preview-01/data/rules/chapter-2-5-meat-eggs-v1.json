  "common_rules": [
    {
      "type": "additives",
      "text": "Food additives are permitted only as applicable under Appendix A and the relevant Chapter 2.5 standard."
    },
    {
      "type": "microbiology",
      "text": "Products shall comply with the applicable microbiological requirements in Appendix B where the Chapter 2.5 standard so requires."
    },
    {
      "type": "contaminants",
      "text": "Applicable products must comply with the Food Safety and Standards (Contaminants, Toxins and Residues) Regulations."
    },
    {
      "type": "labelling",
      "text": "Food Safety and Standards (Labelling and Display) Regulations apply in addition to any product-specific naming or declaration requirements."
    },
    {
      "type": "meat_common",
      "text": "All products listed under regulation 2.5.2 are subject to the common meat requirements in Chapter 2.5, including applicable veterinary-drug/advisory compliance, prohibition on genetically modified techniques for production of meat animals or poultry birds, feed-related provisions and segregation of porcine production/slaughter/processing from bovine, ovine and caprine facilities."
    }
  ],
  "standards": [
    {
      "key": "2.5.2(1)",
      "name": "Canned or Retort Pouch Meat Products",
      "status": "structured_core",
      "definition": "Thermally processed shelf-stable meat products packed in hermetically sealed cans, retort pouches or other suitable containers.",
      "process_rules": [
        "Process at a validated temperature, pressure and time combination to achieve commercial sterility.",
        "Sealed containers shall show no changes on incubation at 35°C for 10 days or 55°C for 5 days.",
        "The F0 value required for the product shall be standardised before production and marketing."
      ],
      "ingredient_rules": [
        "Only ingredients standardised or permitted for use in other standardised foods under the regulations may be used."
      ],
      "additives": "Appendix A",
      "microbiology": "Appendix B"
    },
    {
      "key": "2.5.2(2)",
      "name": "Comminuted or Restructured Meat Products",
      "status": "structured_core",
      "definition": "Raw or cooked comminuted or restructured meat products, including mechanically deboned or separated meat products.",
      "permitted_ingredient_groups": [
        "trimmings, fat, skin, edible by-products, mechanically recovered meat (MRM) or mechanically deboned meat (MDM)",
        "water, herbs, sugar, spices, preservatives, condiments, stabilizers, hydrolysed vegetable protein",
        "milk powders, caseinate, whey powder, egg protein and vegetable protein products",
        "meal, flour, fibres or starch from cereal/grain, potato or sweet potato",
        "rusk, bread, biscuit or bakery products",
        "sugars and glucose syrup",
        "dairy products and analogues",
        "fats, oils and fat emulsions",
        "fruits, vegetables, juices, nectars and vegetable protein products",
        "cereal products, egg products, honey, salt and salt substitutes, herbs, spices, seasonings, condiments, vinegar, mustard, sauces, yeast and soybean seasonings",
        "hydrolysed protein and listed permitted hydrocolloids/gums"
      ],
      "formulation_rules": [
        {
          "parameter": "Total meat including lean meat, fat and edible offals",
          "operator": ">=",
          "value": 50,
          "unit": "% of finished product"
        },
        {
          "parameter": "Lean meat",
          "operator": ">=",
          "value": 25,
          "unit": "% of total formulation"
        },
        {
          "parameter": "MRM from non-poultry food animals",
          "operator": "<=",
          "value": 20,
          "unit": "% of meat portion",
          "note": "No usage limit is specified here for MRM derived from poultry."
        },
        {
          "parameter": "Fat — pork products",
          "operator": "<=",
          "value": 30,
          "unit": "%"
        },
        {
          "parameter": "Fat — other food animals",
          "operator": "<=",
          "value": 25,
          "unit": "%"
        },
        {
          "parameter": "Fat — birds and rabbits",
          "operator": "<=",
          "value": 15,
          "unit": "%"
        },
        {
          "parameter": "Combined added water and fat",
          "operator": "<=",
          "value": 40,
          "unit": "%"
        },
        {
          "parameter": "Low-fat claim/product fat",
          "operator": "<=",
          "value": 10,
          "unit": "%"
        },
        {
          "parameter": "Extra-lean product fat",
          "operator": "<",
          "value": 5,
          "unit": "%"
        }
      ],
      "calculated_rules": [
        {
          "parameter": "Maximum final moisture",
          "formula": "4 × protein content (%) + 10",
          "operator": "<=",
          "unit": "%"
        }
      ],
      "classification_rules": [
        {
          "condition": "Extenders/binders > 3.5% in finished product OR isolated soy protein > 2.0%",
          "result": "Product must be labelled 'Imitation'."
        }
      ],
      "storage_rules": [
        {
          "state": "chilled",
          "operator": "<=",
          "value": 4,
          "unit": "°C"
        },
        {
          "state": "frozen",
          "operator": "<=",
          "value": -18,
          "unit": "°C"
        }
      ],
      "additives": "Appendix A",
      "microbiology": "Appendix B"
    },
    {
      "key": "2.5.2(2A)",
      "name": "Meat Sausages",
      "status": "structured_core",
      "definition": "Sausage obtained by stuffing minced meat and other ingredients in natural or artificial casings; may be marketed as fresh/raw, fermented, cooked, smoked or combinations thereof.",
      "inherits_from": [
        "2.5.2(2) Comminuted or Restructured Meat Products"
      ],
      "variants": [
        {
          "name": "Fresh",
          "meat_min_pct": 50,
          "moisture_max_pct": 65,
          "total_ash_max_pct": 3
        },
        {
          "name": "Cooked/Smoked",
          "meat_min_pct": 60,
          "moisture_max_pct": 60,
          "total_ash_max_pct": 3
        },
        {
          "name": "Dry/Fermented",
          "meat_min_pct": 65,
          "moisture_max_pct": 50,
          "total_ash_max_pct": 3
        }
      ],
      "process_rules": [
        "Cooked sausages shall attain an internal temperature of 75°C.",
        "Cooked sausages shall be cooled below 40°C before chilling or freezing.",
        "Fresh meat sausages shall be brought to 4°C within 12 hours.",
        "Smoked sausages shall be smoked only with hard wood or other non-resinous materials."
      ],
      "storage_rules": [
        {
          "state": "fresh chilled",
          "operator": "<=",
          "value": 4,
          "unit": "°C"
        },
        {
          "state": "cooked chilled",
          "operator": "<=",
          "value": 4,
          "unit": "°C"
        },
        {
          "state": "frozen",
          "operator": "<=",
          "value": -18,
          "unit": "°C"
        }
      ],
      "additives": "Appendix A",
      "microbiology": "Appendix B",
      "enforcement_note": "The standard was notified with compliance from 1 February 2026. FSSAI direction dated 28 April 2026 further extended the compliance period for the Meat Sausage standards for six months from 1 May 2026. PMSV should display this status and confirm the operative enforcement position before using the sausage clause as a hard-fail compliance gate."
    },
    {
      "key": "2.5.2(3)",
      "name": "Cured or Pickled and Cooked or Smoked Meat Products, or both",
      "status": "structured_core",
      "definition": "Cured or pickled and cooked or smoked meat products, or both, prepared by curing/pickling, salting, cooking and/or smoking.",
      "required_ingredients": [
        "meat",
        "food-grade sodium chloride or potassium chloride",
        "nitrites",
        "phosphates"
      ],
      "conditional_ingredients": [
        {
          "condition": "pickled meat product",
          "required": "vinegar"
        }
      ],
      "permitted_ingredient_groups": [
        "milk powders/caseinate/whey",
        "hydrolysed vegetable protein/soya",
        "sugars and syrups",
        "honey/treacle/molasses",
        "herbs, spices, seasonings, condiments, saffron, vinegars, mustards, sauces, yeast, soybean seasonings, juniper berries and smoke/smoke essences"
      ],
      "storage_rules": [
        {
          "state": "chilled",
          "operator": "<=",
          "value": 4,
          "unit": "°C"
        },
        {
          "state": "frozen",
          "operator": "<=",
          "value": -18,
          "unit": "°C",
          "note": "Frozen storage requirement excludes pickled meat products."
        }
      ],
      "additives": "Appendix A",
      "microbiology": "Appendix B"
    },
    {
      "key": "2.5.2(4)",
      "name": "Dried or Dehydrated Meat Products",
      "status": "structured_core",
      "variants": [
        {
          "name": "Low-moisture meat product",
          "water_activity_operator": "<",
          "water_activity": 0.6,
          "moisture_operator": "<",
          "moisture_pct": 25
        },
        {
          "name": "Intermediate-moisture meat product",
          "water_activity_range": [
            0.6,
            0.85
          ],
          "moisture_operator": "<",
          "moisture_pct": 50
        }
      ],
      "process_rules": [
        "Drying may be by salting, solar, mechanical, vacuum or freeze drying to achieve the required moisture and water-activity level."
      ],
      "storage_rules": [
