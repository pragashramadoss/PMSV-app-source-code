      "name": "Animal Casings",
      "status": "structured_core",
      "definition": "Soft cylindrical containers obtained from large or small intestines, oesophagus or urinary bladder of slaughtered food animals for preparation of meat products such as sausages.",
      "process_rules": [
        "Casings shall be dried or wet salted and calibrated as specified.",
        "Adhering tissues and contents shall be removed, followed by washing, salting and/or drying and sorting."
      ],
      "prohibited_or_absent": [
