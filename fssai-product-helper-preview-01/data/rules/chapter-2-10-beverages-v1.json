{
  "schema_version": "1.0",
  "chapter": "2.10",
  "title": "Beverages (Other than Dairy and Fruits & Vegetables Based)",
  "source_version": "Version 4 (01.08.2025)",
  "source_verified_on": "2026-10-02",
  "official_sources": [
    {
      "authority": "FSSAI",
      "title": "Chapter 2.10 — Beverages (Other than Dairy and Fruits & Vegetables Based), Version 4 (01.08.2025)",
      "url": "https://www.fssai.gov.in/upload/uploadfiles/files/Chapter%202_10_BEVERAGES_Other%20than%20Dairy%20and%20Fruits%20Vegetables%20based.pdf"
    },
    {
      "authority": "FoSCoS",
      "title": "View all FSSAI Standardized Food Products",
      "url": "https://fcstraining.fssai.gov.in/standard-product"
    }
  ],
  "regulatory_notes": [
    "The current consolidated Chapter 2.10 is Version 4 dated 01.08.2025.",
    "Sub-regulation 2.10.5 is omitted.",
    "The amended Packaged Drinking Water limits for Total Dissolved Solids (75–500 mg/L), Calcium (10–75 mg/L) and Magnesium (5–30 mg/L) came into force on 1 February 2026 and are treated as current values in PMSV.",
    "A 2024 draft proposed renaming/reshaping Carbonated Water into Carbonated Beverages plus a separate Carbonated Water clause. PMSV does not apply that draft as operative because the current consolidated Chapter 2.10 still contains the operative Carbonated Water text under 2.10.6(1).",
    "Alcoholic beverages under FoSCoS Category 14.2 are governed by the separate FSS (Alcoholic Beverages) Regulations and are not mapped into Chapter 2.10."
  ],
  "common_rules": [
    {
      "type": "additives",
      "text": "Appendix A permissions apply where referenced; product-specific limits prevail."
    },
    {
      "type": "microbiology",
      "text": "Appendix B applies where referenced; Carbonated Water, Mineral Water and Packaged Drinking Water also contain direct microbiological criteria in this chapter."
    },
    {
      "type": "processing_aids",
      "text": "Appendix C processing aids apply where the product standard permits them."
    },
    {
      "type": "labelling",
      "text": "Current Food Safety and Standards (Labelling and Display) Regulations, 2020 apply in addition to product-specific declarations, despite historical references in older text to the 2011 labelling regulations."
    }
  ],
  "omitted_standards": [
    {
      "key": "2.10.5",
      "status": "omitted"
    }
  ],
  "draft_not_active": [
    {
      "topic": "Carbonated Beverages / separate Carbonated Water amendment",
      "status": "draft_not_active",
      "note": "Not promoted to operative rule because current consolidated Chapter 2.10 Version 4 retains 2.10.6(1) Carbonated Water."
    }
  ],
