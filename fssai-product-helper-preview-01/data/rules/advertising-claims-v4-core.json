    "fail_closed_rule": "If the claim condition depends on a nutrient, comparator, laboratory result, process history, scientific substantiation or product classification that PMSV cannot verify deterministically, the claim is returned as NEEDS EVIDENCE rather than approved."
  },
  "current_source": {
    "authority": "Food Safety and Standards Authority of India",
    "regulation": "Food Safety and Standards (Advertising and Claims) Regulations, 2018",
    "compendium_version": "Version IV (14.12.2022)",
    "url": "https://fssai.gov.in/upload/uploadfiles/files/Compendium_Advertising_Claims_Regulations_14_12_2022.pdf",
    "amendment_count": 3,
    "amendments": [
      "09.10.2020",
      "30.08.2022",
      "13.12.2022"
    ]
  },
  "general_principles": [
    {
      "id": "truthful",
      "clause": "Reg. 4(1)",
      "text": "Claims must be truthful, unambiguous, meaningful, not misleading and help consumers comprehend the information."
    },
    {
      "id": "no_excess",
      "clause": "Reg. 4(2)",
      "text": "Claims shall not encourage or condone excess consumption of a particular food."
    },
    {
      "id": "balanced_diet",
      "clause": "Reg. 4(3)",
      "text": "Claims shall not suggest that a balanced and varied diet cannot provide appropriate quantities of nutrients."
    },
    {
      "id": "prep_method",
      "clause": "Reg. 4(4)",
      "text": "Where the claimed benefit depends on preparation, the relevant preparation method must be provided on the label."
    },
    {
      "id": "disease_servings",
      "clause": "Reg. 4(5)",
      "text": "Reduction-of-disease-risk claims must specify the number of servings per day for the claimed benefit."
    },
    {
      "id": "substantiation",
      "clause": "Reg. 4(6)",
      "text": "Nutritional or health attributes must be scientifically substantiated using validated methods for the ingredient or substance that is the basis of the claim."
    },
    {
      "id": "brand_disclaimer",
      "clause": "Reg. 4(7)",
      "text": "Potentially misleading brand/fancy names using words such as natural, fresh, pure, original, traditional, authentic, genuine or real require the prescribed front-of-pack disclaimer."
    },
    {
      "id": "no_fssai_promotion",
      "clause": "Reg. 4(9)",
      "text": "FSSAI logo or licence number shall not be used to make or promote a claim."
    },
    {
      "id": "healthy_lifestyle",
      "clause": "Reg. 4(10)",
      "text": "Advertisements shall not undermine the importance of healthy lifestyles."
    },
    {
      "id": "meal_replacement",
      "clause": "Reg. 4(11)",
      "text": "Food or beverage advertisements shall not portray the product as a meal replacement unless specifically permitted."
    },
    {
      "id": "label_consistency",
      "clause": "Reg. 4(12)",
      "text": "Claims in advertisements must be consistent with information on the label."
    },
    {
      "id": "no_deception",
      "clause": "Reg. 4(13)",
      "text": "No deceptive advertisement shall be made."
    }
  ],
  "comparative_claims": {
    "clause": "Reg. 5(4)-(5)",
    "same_or_similar_food_required": true,
    "thresholds": {
      "energy_or_macronutrients_percent": 30,
      "micronutrients_other_than_sodium_rda_percent_per_100g_or_100ml": 10,
      "sodium_percent": 25,
      "salt_sold_as_such_percent": 10
    },
    "proximity_declaration_required": true
  },
  "non_addition_claims": {
    "sugars": {
      "clause": "Reg. 6(1)",
      "conditions": [
        "No sugars of any type are added.",
        "No ingredient containing sugars as an ingredient is used.",
        "No ingredient containing sugars that substitutes for added sugars is used.",
        "The sugar content is not increased by other means such as enzymatic starch hydrolysis."
      ],
      "naturally_occurring_declaration": "CONTAINS NATURALLY OCCURRING SUGARS"
    },
    "sodium_salts": {
      "clause": "Reg. 6(2)",
      "conditions": [
        "No sodium salts are added.",
        "No ingredient containing added sodium salts is used.",
        "No ingredient containing sodium salts that substitutes for added salt is used."
      ]
    },
    "additives": {
      "clause": "Reg. 6(3)",
      "conditions": [
        "The additive or functional class has not been added or removed at manufacture.",
        "It is not contained in any ingredient except where naturally present.",
        "It is an additive permitted for that product.",
        "It has not been replaced by another additive giving equivalent characteristics."
      ]
    }
  },
  "prohibited_claims": [
    {
      "id": "disease_prevention_treatment_cure",
      "clause": "Reg. 10(1)",
      "text": "No claim may refer to suitability for prevention, alleviation, treatment or cure of a disease, disorder or physiological condition unless specifically permitted under another FSSAI regulation."
    },
    {
      "id": "medical_recommendation",
      "clause": "Reg. 10(2)",
      "text": "Labels shall not state or imply recommendation, prescription or approval by medical, nutrition or health professionals or for medical purpose."
    },
    {
      "id": "added_nutrients_replacement",
      "clause": "Reg. 10(3)",
      "text": "The term 'added nutrients' shall not be claimed when nutrients were added merely to compensate nutrients lost or removed during processing."
    },
    {
      "id": "fear_or_safety_doubt",
      "clause": "Reg. 10(5)",
      "text": "Claims that create doubt or suspicion about the safety of similar food or arouse fear are prohibited."
    },
    {
      "id": "adverse_quantity_health_claim",
      "clause": "Reg. 10(6)",
      "text": "No health claim shall be made for food containing nutrients or constituents in quantities that increase disease or adverse-health risk."
    },
    {
      "id": "undermine_competitor",
      "clause": "Reg. 10(7)",
      "text": "Advertisements or claims shall not undermine another manufacturer's products to promote the advertiser's product."
    }
  ],
