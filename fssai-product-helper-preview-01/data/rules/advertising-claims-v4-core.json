  "schedule_v": [
    {
      "term": "Natural",
      "clause": "Reg. 9(2) / Schedule V",
      "auto_evaluable": false,
      "summary": "Restricted to qualifying single foods or qualifying natural ingredients/additives; composite foods may use 'made from natural ingredients' only when all ingredients/additives qualify. 'Natural goodness', 'naturally better' and 'nature's way' shall not be used."
    },
    {
      "term": "Fresh",
      "clause": "Reg. 9(2) / Schedule V",
      "auto_evaluable": false,
      "summary": "Restricted to products not processed beyond the permitted minimal processes; special conditions apply to frozen-from-fresh expressions."
    },
    {
      "term": "Pure",
      "clause": "Reg. 9(2) / Schedule V",
      "auto_evaluable": false,
      "summary": "Restricted to qualifying single-ingredient food with nothing added and compliant contaminant levels; compound foods may use 'made with pure ingredients' only when all ingredients qualify."
    },
    {
      "term": "Authentic / Genuine / Real",
      "clause": "Reg. 9(2) / Schedule V",
      "auto_evaluable": false,
      "summary": "Use requires clarification of the tangible quality justification and why the term is used."
    },
    {
      "term": "Traditional",
      "clause": "Reg. 9(2) / Schedule V",
      "auto_evaluable": false,
      "summary": "Recipe, fundamental formulation or process must demonstrably have existed substantially unchanged for a generation (30 years)."
    },
    {
      "term": "Original",
      "clause": "Reg. 9(2) / Schedule V",
      "auto_evaluable": false,
      "summary": "Origin of formulation/process must be traceable and essentially unchanged; major ingredients cannot be replaced and the product must remain the standard product when variants are introduced."
    }
  ],
