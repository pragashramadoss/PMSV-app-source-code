  "common_rules": [
    {
      "type": "additives",
      "text": "Food additives are permitted only where allowed by the relevant Chapter 2.4 standard and Appendix A."
    },
    {
      "type": "microbiology",
      "text": "Where the Chapter 2.4 standard refers to Appendix B, the applicable microbiological requirements also apply."
    },
    {
      "type": "contaminants",
      "text": "Applicable products must comply with the Food Safety and Standards (Contaminants, Toxins and Residues) Regulations."
    },
    {
      "type": "labelling",
      "text": "General Labelling and Display Regulations apply in addition to product-specific declarations."
    }
  ],
