  "common_rules": [
    {
      "type": "additives",
      "text": "Food additives are permitted only as allowed by the applicable product standard and Appendix A. Product-specific restrictions override general permissions."
    },
    {
      "type": "microbiology",
      "text": "Where the Chapter 2.7 standard refers to Appendix B, the applicable microbiological requirements also apply."
    },
    {
      "type": "contaminants",
      "text": "Applicable products must comply with the Food Safety and Standards (Contaminants, Toxins and Residues) Regulations."
    },
    {
      "type": "labelling",
      "text": "Current Food Safety and Standards (Labelling and Display) Regulations, 2020 apply. Historical references in the consolidated Chapter 2.7 text to the former Packaging and Labelling Regulations, 2011 are not treated as the current labelling instrument."
    }
  ],
  "standards": [
    {
      "key": "2.7.1",
      "name": "Sugar Boiled Confectionery",
      "status": "structured_core",
      "applies_to": [
        "hard boiled sugar confectionery",
        "pan goods confectionery",
        "toffee",
        "milk toffee",
        "modified toffee",
        "lacto-bon-bon",
        "other equivalent sugar-boiled confectionery"
      ],
      "permitted_ingredient_groups": [
        "sugar, invert sugar, jaggery, lactose, gur, bura sugar, khandsari, sorbitol, honey and liquid glucose",
        "milk and milk products",
        "edible molasses",
        "malt extracts",
        "edible starches",
        "edible oils and fats",
        "edible common salt",
        "fruit and fruit products",
        "nuts and nut products",
        "tea extract",
        "coffee extract",
        "chocolate and cocoa",
        "vitamins and minerals",
        "edible desiccated coconut",
        "spices and condiments and their extracts",
        "candied peels",
        "enzymes",
        "permitted stabilising and emulsifying agents",
        "edible foodgrains and edible seeds",
        "baking powder",
        "gulkand, gulabanafsha and mulathi",
        "puffed rice",
        "china grass",
        "eucalyptus oil, camphor, menthol oil crystals and peppermint oil",
        "thymol",
        "edible oil-seed flour and protein isolates",
        "gum arabic and other edible gums"
      ],
      "formulation_rules": [
        {
          "parameter": "Food-grade shellac",
          "operator": "<=",
          "value": 0.4,
          "unit": "% by weight"
        },
        {
          "parameter": "Isomaltulose",
          "operator": "<=",
          "value": 50,
          "unit": "% of total sugars",
          "condition": "When used"
        }
      ],
      "composition": [
        {
          "parameter": "Sulphated ash on salt-free basis",
          "operator": "<=",
          "value": 2.5,
          "unit": "% by weight"
        },
        {
          "parameter": "Sulphated ash with spices used as centre filling",
          "operator": "<=",
          "value": 3,
          "unit": "% by weight"
        },
        {
          "parameter": "Ash insoluble in dilute HCl",
          "operator": "<=",
          "value": 0.2,
          "unit": "% by weight"
        },
        {
          "parameter": "Ash insoluble in dilute HCl with spices used as centre filling",
          "operator": "<=",
          "value": 0.4,
          "unit": "% by weight"
        }
      ],
      "variants": [
        {
          "name": "Milk Toffee",
          "protein_min_pct_dry_basis": 3,
          "fat_min_pct_dry_basis": 4
        },
        {
          "name": "Butter Toffee",
          "fat_min_pct_dry_basis": 4
        }
      ],
      "additives": "Appendix A"
    },
    {
      "key": "2.7.2",
      "name": "Lozenges",
      "status": "structured_core",
      "definition": "Confections made mainly from pulverised or icing sugar with binding materials such as edible gums, edible gelatin, liquid glucose or dextrin, generally by cold mixing without primary boiling/cooking.",
      "permitted_ingredient_groups": [
        "dextrose, dextrose monohydrate, honey, invert sugar, sugar, jaggery, bura sugar, khandsari, sorbitol and liquid glucose",
        "milk and milk products",
        "nuts and nut products",
        "malt syrup",
        "edible starches",
        "edible common salt",
        "ginger, cinnamon, aniseed, caraway and cardamom powders or extracts",
        "cocoa powder or extracts",
        "protein isolates",
        "coffee extracts or flavour",
        "permitted colouring matter",
        "permitted emulsifying and stabilising agents",
        "vitamins and minerals"
      ],
      "formulation_rules": [
        {
          "parameter": "Isomaltulose",
          "operator": "<=",
          "value": 50,
          "unit": "% of total sugars",
          "condition": "When used"
        }
      ],
      "composition": [
        {
          "parameter": "Sucrose",
          "operator": ">=",
          "value": 85,
          "unit": "% by weight",
          "exception": "Not applicable when only permitted artificial sweetener is used as sweetener."
        },
        {
          "parameter": "Sulphated ash on salt-free basis",
          "operator": "<=",
          "value": 3,
          "unit": "% by weight"
        },
        {
          "parameter": "Ash insoluble in dilute HCl",
          "operator": "<=",
          "value": 0.2,
          "unit": "% by weight"
        }
      ],
      "additives": "Appendix A"
    },
