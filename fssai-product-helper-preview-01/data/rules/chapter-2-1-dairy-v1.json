      "key": "2.1.1",
      "name": "General Standards for Milk and Milk Products",
      "status": "structured_core",
      "rules": [
        {
          "type": "inheritance",
          "text": "General dairy definitions, heat-treatment concepts, use of dairy terms, dairy-term restrictions and generic labelling apply across Chapter 2.1 unless a product standard states otherwise."
        },
        {
          "type": "label",
          "text": "Dairy analogues require the prescribed constituent-replacement declarations close to the product name."
        }
      ]
    },
