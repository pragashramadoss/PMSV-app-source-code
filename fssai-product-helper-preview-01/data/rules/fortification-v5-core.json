  "general_rules": [
    {
      "id": "general_1",
      "clause": "Reg. 3",
      "text": "Micronutrients may be added for the purposes specified in the regulations; heme iron shall not be used where Iron (as Fe) is the nutrient source."
    },
    {
      "id": "processed_food_rda",
      "clause": "Reg. 3(6)",
      "text": "Fortified Processed Food shall provide 15–30% of Indian adult RDA of micronutrient based on an average 600 kcal intake from processed foods."
    },
    {
      "id": "hfss_exclusion",
      "clause": "Reg. 3(7)",
      "text": "HFSS foods are excluded from the Fortified Processed Foods category."
    },
    {
      "id": "schedule_i_compliance",
      "clause": "Reg. 4(1)",
      "text": "Added micronutrients in fortified food shall fall within the Schedule I range; minus 10% tolerance of the declared total label value may be allowed for compliance/analysis, but the Schedule I maximum added level must still be met."
    },
    {
      "id": "schedule_iii_compliance",
      "clause": "Reg. 4(2)",
      "text": "Fortified processed foods shall meet Schedule III micronutrient ranges."
    },
    {
      "id": "qa",
      "clause": "Reg. 5",
      "text": "Manufacturer/packer shall submit quality-assurance undertaking twice a year, including notified-lab certification, fortificant inventory/source records, process monitoring, random testing and equipment/process audit."
    },
    {
      "id": "other_regulations",
      "clause": "Reg. 6",
      "text": "Fortified food must also comply with all other applicable FSSAI regulations."
    },
    {
      "id": "packaging",
      "clause": "Reg. 7(1)",
      "text": "Packaging shall consider the nature of the fortificant and its effect on shelf life."
    },
    {
      "id": "label_logo",
      "clause": "Reg. 7(2)",
      "text": "Except iodized salt fortified only with iodine, the package shall carry 'fortified with … (name of fortificant)' and the Schedule II +F logo; the tagline may also be used."
    },
    {
      "id": "iron_warning",
      "clause": "Reg. 7(4)",
      "text": "Every package of food fortified with iron shall carry the prescribed Thalassemia/Sickle Cell Anaemia warning."
    }
  ],
