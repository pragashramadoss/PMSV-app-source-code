    }
  ],
  "regulatory_notes": [
    "The active consolidated Chapter 2.8 is Version 1 dated 01.09.2023.",
    "A 2024 draft proposed a new 2.8.13 standard for High Fructose Corn Syrup. It is not present in the current consolidated Chapter 2.8 and is therefore not treated as an operative Chapter 2.8 product standard in PMSV.",
    "FSSAI advisory dated 07.11.2025 clarifies that Honey exceeding the 80 mg/kg HMF limit is to be categorised as Substandard; the 80 mg/kg numerical limit itself remains unchanged."
  ],
  "common_rules": [
    {
      "type": "additives",
      "text": "Food additives are permitted only where allowed by the relevant Chapter 2.8 standard and Appendix A. Honey under 2.8.3(1) explicitly permits no added food ingredient or food additive."
    },
    {
      "type": "contaminants",
      "text": "Applicable products must comply with the Food Safety and Standards (Contaminants, Toxins and Residues) Regulations."
    },
    {
      "type": "microbiology",
      "text": "Appendix B microbiological requirements apply where expressly referenced by the product standard."
    },
    {
      "type": "labelling",
      "text": "Current Food Safety and Standards (Labelling and Display) Regulations, 2020 apply in addition to product-specific declarations. Historical references in the consolidated chapter to the former Packaging and Labelling Regulations, 2011 are not treated as the current labelling instrument."
    }
  ],
  "draft_not_active": [
    {
      "key": "2.8.13",
      "name": "High Fructose Corn Syrup",
      "status": "draft_not_active",
      "source": "Draft Food Safety and Standards (Food Products Standards and Food Additives) Amendment Regulations, 2024",
      "note": "Not loaded as an operative standard because the current consolidated Chapter 2.8 does not contain 2.8.13."
    }
  ],
