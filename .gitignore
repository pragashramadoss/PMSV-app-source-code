# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
# Checkout-local execution profile and tool state; never publish them.
/.sites-runtime/
/.agents/
/.codex/
/outputs/
/work/

*.tsbuildinfo

# Packaged desktop and iPhone builds
/platforms/node_modules/
/platforms/www/
/platforms/release/
/platforms/test-results/
/platforms/ios/App/App/public/
/platforms/ios/App/Pods/
/platforms/ios/App/build/
/platforms/ios/App/DerivedData/
/platforms/ios/App/App.xcworkspace/xcuserdata/
/platforms/ios/App/App.xcodeproj/xcuserdata/

# Signing identities must never enter source control.
*.p8
*.p12
*.pfx
*.mobileprovision
/platforms/handoff/
